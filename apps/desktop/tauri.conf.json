{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Writey",
  "version": "1.0.0",
  "identifier": "com.writey.notebook",
  "build": {
    "beforeDevCommand": "pnpm --filter @writey/web dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --filter @writey/web build",
    "frontendDist": "../web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Writey",
        "width": 1360,
        "height": 900,
        "minWidth": 720,
        "minHeight": 520,
        "center": true,
        "dragDropEnabled": false,
        "backgroundColor": "#f2efe7"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' ipc: http://ipc.localhost",
        "connect-src": "'self' ipc: http://ipc.localhost https://commons.wikimedia.org https://upload.wikimedia.org",
        "img-src": "'self' data: blob: https://upload.wikimedia.org",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "worker-src": "'self' blob:",
        "media-src": "'self' blob:"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "app"],
    "category": "Education",
    "shortDescription": "A notebook for your pen that writes back",
    "longDescription": "Write and solve with your pen tablet; ask Writey by voice or text and it writes the next step on your page in handwriting.",
    "copyright": "MIT License",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/silero_vad.onnx": "resources/silero_vad.onnx"
    },
    "fileAssociations": [
      {
        "ext": ["writey"],
        "name": "Writey notebooks",
        "description": "Writey notebooks",
        "role": "Editor",
        "mimeType": "application/x-writey"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      },
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "entitlements": "Entitlements.plist",
      "signingIdentity": "-",
      "hardenedRuntime": true
    }
  },
  "plugins": {}
}
