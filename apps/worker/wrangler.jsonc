{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "writey",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  // The React app is built into ../web/dist and served as static assets.
  // Only /api/* reaches the Worker; everything else is the single-page app.
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Page ink blobs and uploaded PDFs/images.
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "writey" }],
  "vars": {
    "SUPABASE_URL": "https://ksnpzfgcxjallzucvuhr.supabase.co",
    // Public by design (it also ships in the web bundle). RLS protects the data.
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_ga-uXWG_WWoxz5jrl4y6hQ_UcZ7JNgo"
  }
}
