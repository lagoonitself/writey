{
  "name": "writey",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.29.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter @writey/web --filter @writey/worker dev",
    "build": "pnpm --filter @writey/web build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "deploy": "pnpm --filter @writey/web build && pnpm --filter @writey/worker run deploy",
    "app": "pnpm --filter @writey/desktop tauri dev",
    "app:build": "pnpm --filter @writey/desktop tauri build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "typescript": "7.0.2"
  }
}
